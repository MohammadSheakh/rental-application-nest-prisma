enum SettingsType {
  aboutUs
  contactUs
  privacyPolicy
  termsAndConditions
  introductionVideo
}

model Settings {
  id                String       @id @default(cuid())

  // One settings row per static-content type, such as privacy policy or about us.
  type              SettingsType @unique
  details           String       @default("")
  introductionVideo Json?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([type])
}
