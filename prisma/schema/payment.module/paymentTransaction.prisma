enum PaymentGateway {
  stripe
  paypal
  sslcommerz
  revenuecat
  none
}

enum PaymentStatus {
  pending
  processing
  completed
  failed
  refunded
  cancelled
  partially_refunded
  disputed
}

enum PaymentCurrency {
  usd
  bdt
  eur
  gbp
}

enum TransactionType {
  userSubscription
  purchasedJourney
  purchasedAdminCapsule
}

enum PaymentEnvironment {
  production
  sandbox
}

enum PaymentPlatform {
  ios
  android
  web
}

model PaymentTransaction {
  id                    String              @id @default(cuid())

  // 🔗 One user can have many payment transactions.
  userId                String
  user                  User                @relation(fields: [userId], references: [id])

  // 🔗 Polymorphic payment target, such as userSubscription or purchase.
  referenceFor          TransactionType
  referenceId           String
  paymentGateway        PaymentGateway
  transactionId         String?
  paymentIntent         String?
  amount                Int
  currency              PaymentCurrency
  paymentStatus         PaymentStatus       @default(pending)
  gatewayResponse       Json?
  revenueCatOrderId     String?
  revenueCatEnvironment PaymentEnvironment?
  platform              PaymentPlatform?
  isDeleted             Boolean             @default(false)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([userId, paymentStatus, isDeleted])
  @@index([referenceFor, referenceId, isDeleted])
  @@index([paymentGateway, transactionId])
  @@index([revenueCatOrderId, isDeleted])
  @@index([createdAt, isDeleted])
  @@index([paymentStatus, createdAt, isDeleted])
}
