enum TaskReminderTrigger {
  scheduled
  before_due
  after_creation
  overdue
}

enum TaskReminderStatus {
  pending
  sent
  failed
  cancelled
}

enum TaskReminderFrequency {
  once
  daily
  weekly
  monthly
}

model TaskReminder {
  id              String                @id @default(cuid())

  // 🔗 Task ID kept as a string because Task model is not in Prisma schema yet.
  taskId          String

  // 🔗 Many reminders can belong to one user.
  userId          String
  user            User                  @relation("TaskReminderUser", fields: [userId], references: [id])

  // 🔗 Many reminders can be created by one user.
  createdByUserId String
  createdByUser   User                  @relation("TaskReminderCreator", fields: [createdByUserId], references: [id])
  triggerType     TaskReminderTrigger
  reminderTime    DateTime
  customMessage   String?
  status          TaskReminderStatus    @default(pending)
  frequency       TaskReminderFrequency @default(once)
  deliveryChannels String[]
  sentCount       Int                   @default(0)
  lastSentAt      DateTime?
  nextReminderTime DateTime?
  bullJobId       String?
  isDeleted       Boolean               @default(false)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([userId, status, isDeleted])
  @@index([taskId, isDeleted])
  @@index([reminderTime, status])
}
