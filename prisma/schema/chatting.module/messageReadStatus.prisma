model MessageReadStatus {
  id             String       @id @default(cuid())

  // 🔗 Many read-status rows can belong to one message.
  messageId      String
  message        Message      @relation(fields: [messageId], references: [id])

  // 🔗 Many read-status rows can belong to one user.
  userId         String
  user           User         @relation(fields: [userId], references: [id])

  // 🔗 Many read-status rows can belong to one conversation.
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  isRead         Boolean      @default(false)
  readAt         DateTime?
  isDeleted      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([messageId, userId])
  @@index([messageId, userId, isDeleted])
  @@index([conversationId, userId, isRead])
  @@index([userId, isRead])
}
