model WithdrawalRequest{

    id String @id @default(cuid())

    // for back reference .. 
    userId String     //🔗  one user can have many txn history
    user User @relation(fields:[userId], references: [id])

    walletId String  //🔗
    wallet Wallet @relation(fields:[walletId], references: [id])

    
