// Source: chatting.module/conversation.prisma
enum ConversationType {
  direct
  group
}

enum ParticipantRole {
  admin
  member
}

model Conversation {
  id                   String   @id @default(cuid())

  // 🔗 Many conversations can be created by one user.
  creatorId            String
  creator              User     @relation("ConversationCreator", fields: [creatorId], references: [id])

  type                 ConversationType
  groupName            String?
  groupProfilePicture  String?

  // Last message snapshot for faster conversation list loading.
  lastMessageId        String?
  lastMessageText      String?
  lastMessageCreatedAt DateTime?
  isDeleted            Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  // 🔗 One conversation can have many participants.
  participants ConversationParticipents[]

  // 🔗 One conversation can have many messages.
  messages     Message[]

  // 🔗 One conversation can have many read-status rows.
  readStatuses MessageReadStatus[]

  @@index([creatorId, isDeleted])
  @@index([type, isDeleted])
  @@index([lastMessageCreatedAt, isDeleted])
}


// Source: chatting.module/conversationParticipents.prisma
model ConversationParticipents {
  id                         String          @id @default(cuid())

  // 🔗 Many participant rows can belong to one user.
  userId                     String
  user                       User            @relation(fields: [userId], references: [id])
  userName                   String

  // 🔗 Many participant rows can belong to one conversation.
  conversationId             String
  conversation               Conversation    @relation(fields: [conversationId], references: [id])
  joinedAt                   DateTime        @default(now())
  role                       ParticipantRole
  lastMessageReadAt          DateTime?
  lastMessageReadId          String?
  unreadCount                Int             @default(0)
  isThisConversationUnseen   Int             @default(0)
  isDeleted                  Boolean         @default(false)
  createdAt                  DateTime        @default(now())
  updatedAt                  DateTime        @updatedAt

  @@index([userId, conversationId, isDeleted])
  @@index([conversationId, isDeleted])
  @@index([userId, isDeleted])
}


// Source: chatting.module/message.prisma
model Message {
  id             String       @id @default(cuid())
  text           String

  // 🔗 Many messages can be sent by one user.
  senderId       String
  sender         User         @relation("MessageSender", fields: [senderId], references: [id])

  // 🔗 Many messages can belong to one conversation.
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  isDeleted      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // 🔗 Many-to-many: one message can include many attachments.
  attachments  Attachment[]

  // 🔗 One message can have many read-status rows, one per reader.
  readStatuses MessageReadStatus[]

  @@index([conversationId, createdAt, isDeleted])
  @@index([senderId, isDeleted])
  @@index([createdAt, isDeleted])
}


// Source: chatting.module/messageReadStatus.prisma
model MessageReadStatus {
  id             String       @id @default(cuid())

  // 🔗 Many read-status rows can belong to one message.
  messageId      String
  message        Message      @relation(fields: [messageId], references: [id])

  // 🔗 Many read-status rows can belong to one user.
  userId         String
  user           User         @relation(fields: [userId], references: [id])

  // 🔗 Many read-status rows can belong to one conversation.
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  isRead         Boolean      @default(false)
  readAt         DateTime?
  isDeleted      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([messageId, userId])
  @@index([messageId, userId, isDeleted])
  @@index([conversationId, userId, isRead])
  @@index([userId, isRead])
}


// Source: notification.module/notification.prisma
enum NotificationType {
  task
  group
  system
  reminder
  mention
  assignment
  deadline
  custom
}

enum NotificationPriority {
  low
  normal
  high
  urgent
}

enum NotificationStatus {
  pending
  sent
  delivered
  read
  failed
}

model Notification {
  id           String               @id @default(cuid())

  // 🔗 Many notifications can be sent by one user.
  senderId     String?
  sender       User?                @relation("NotificationSender", fields: [senderId], references: [id])

  // 🔗 Many notifications can be received by one user.
  receiverId   String?
  receiver     User?                @relation("NotificationReceiver", fields: [receiverId], references: [id])

  // Role broadcast target when receiverId is empty.
  receiverRole String?
  type         NotificationType
  priority     NotificationPriority @default(normal)
  status       NotificationStatus   @default(pending)
  title        String
  message      String?
  // 🔗 Polymorphic target: notification can point to a task, group, message, etc.
  entityType   String?
  entityId     String?
  linkFor      String?
  linkId       String?
  data         Json?
  isRead       Boolean              @default(false)
  readAt       DateTime?
  deliveredAt  DateTime?
  isDeleted    Boolean              @default(false)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([receiverId, isRead, isDeleted, createdAt])
  @@index([receiverId, status, isDeleted])
  @@index([senderId, isDeleted])
  @@index([type, isDeleted])
  @@index([entityType, entityId, isDeleted])
  @@index([receiverRole, isDeleted])
}


// Source: notification.module/taskReminder.prisma
enum TaskReminderTrigger {
  scheduled
  before_due
  after_creation
  overdue
}

enum TaskReminderStatus {
  pending
  sent
  failed
  cancelled
}

enum TaskReminderFrequency {
  once
  daily
  weekly
  monthly
}

model TaskReminder {
  id              String                @id @default(cuid())

  // 🔗 Task ID kept as a string because Task model is not in Prisma schema yet.
  taskId          String

  // 🔗 Many reminders can belong to one user.
  userId          String
  user            User                  @relation("TaskReminderUser", fields: [userId], references: [id])

  // 🔗 Many reminders can be created by one user.
  createdByUserId String
  createdByUser   User                  @relation("TaskReminderCreator", fields: [createdByUserId], references: [id])
  triggerType     TaskReminderTrigger
  reminderTime    DateTime
  customMessage   String?
  status          TaskReminderStatus    @default(pending)
  frequency       TaskReminderFrequency @default(once)
  deliveryChannels String[]
  sentCount       Int                   @default(0)
  lastSentAt      DateTime?
  nextReminderTime DateTime?
  bullJobId       String?
  isDeleted       Boolean               @default(false)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([userId, status, isDeleted])
  @@index([taskId, isDeleted])
  @@index([reminderTime, status])
}


// Source: payment.module/paymentTransaction.prisma
enum PaymentGateway {
  stripe
  paypal
  sslcommerz
  revenuecat
  none
}

enum PaymentStatus {
  pending
  processing
  completed
  failed
  refunded
  cancelled
  partially_refunded
  disputed
}

enum PaymentCurrency {
  usd
  bdt
  eur
  gbp
}

enum TransactionType {
  userSubscription
  purchasedJourney
  purchasedAdminCapsule
}

enum PaymentEnvironment {
  production
  sandbox
}

enum PaymentPlatform {
  ios
  android
  web
}

model PaymentTransaction {
  id                    String              @id @default(cuid())

  // 🔗 One user can have many payment transactions.
  userId                String
  user                  User                @relation(fields: [userId], references: [id])

  // 🔗 Polymorphic payment target, such as userSubscription or purchase.
  referenceFor          TransactionType
  referenceId           String
  paymentGateway        PaymentGateway
  transactionId         String?
  paymentIntent         String?
  amount                Int
  currency              PaymentCurrency
  paymentStatus         PaymentStatus       @default(pending)
  gatewayResponse       Json?
  revenueCatOrderId     String?
  revenueCatEnvironment PaymentEnvironment?
  platform              PaymentPlatform?
  isDeleted             Boolean             @default(false)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([userId, paymentStatus, isDeleted])
  @@index([referenceFor, referenceId, isDeleted])
  @@index([paymentGateway, transactionId])
  @@index([revenueCatOrderId, isDeleted])
  @@index([createdAt, isDeleted])
  @@index([paymentStatus, createdAt, isDeleted])
}


