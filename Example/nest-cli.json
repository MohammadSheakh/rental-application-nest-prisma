{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": false
  },
  "projects": {
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    },
    "database": {
      "type": "library",
      "root": "libs/database",
      "entryFile": "index",
      "sourceRoot": "libs/database/src",
      "compilerOptions": {
        "tsConfigPath": "libs/database/tsconfig.lib.json"
      }
    },
    "jwt-config": {
      "type": "library",
      "root": "libs/jwt-config",
      "entryFile": "index",
      "sourceRoot": "libs/jwt-config/src",
      "compilerOptions": {
        "tsConfigPath": "libs/jwt-config/tsconfig.lib.json"
      }
    },
    "shared": {
      "type": "library",
      "root": "libs/shared",
      "entryFile": "index",
      "sourceRoot": "libs/shared/src",
      "compilerOptions": {
        "tsConfigPath": "libs/shared/tsconfig.lib.json"
      }
    },
    "access-control": {
      "type": "library",
      "root": "libs/access-control",
      "entryFile": "index",
      "sourceRoot": "libs/access-control/src",
      "compilerOptions": {
        "tsConfigPath": "libs/access-control/tsconfig.lib.json"
      }
    }
  }
}